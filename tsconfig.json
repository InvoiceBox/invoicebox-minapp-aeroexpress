{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "useDefineForClassFields": true
    },
    "include": [
        "src",
        "e2e",
        "rsbuild.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        ".storybook"
    ]
}
