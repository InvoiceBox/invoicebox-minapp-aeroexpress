{
    "name": "invoicebox-minapp-aeroexpress",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "start": "rsbuild dev",
        "build": "rsbuild build",
        "preview": "rsbuild preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && prettier --check src",
        "lint:fix": "eslint --fix . && prettier --write src",
        "storybook": "PUBLIC_API_ENV=stage storybook dev -p 6006",
        "build-storybook": "PUBLIC_API_ENV=prod storybook build",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@invoicebox/minapp-sdk": "^5.0.0",
        "@invoicebox/ui": "^0.1.0-alpha.322",
        "dompurify": "^3.4.14",
        "final-form": "^4.20.10",
        "react": "^19.2.7",
        "react-calendar": "^4.8.0",
        "react-dom": "^19.2.7",
        "react-final-form": "^6.5.9",
        "react-toastify": "^9.1.3",
        "styled-components": "^6.1.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@playwright/test": "^1.62.1",
        "@rsbuild/core": "^2.0.12",
        "@rsbuild/plugin-react": "^2.0.1",
        "@rsbuild/plugin-svgr": "^2.0.3",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.4.2",
        "storybook": "^10.5.5",
        "storybook-react-rsbuild": "^3.4.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.1",
        "vitest": "^2.1.8"
    },
    "overrides": {
        "@invoicebox/ui": {
            "react": "$react",
            "react-dom": "$react-dom"
        },
        "react-final-form": {
            "react": "$react"
        },
        "react-calendar": {
            "react": "$react",
            "react-dom": "$react-dom",
            "@types/react": "$@types/react"
        }
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not op_mini all"
    ],
    "type": "module"
}
